# ============================================================
# Salin file ini menjadi .env (untuk dev lokal) atau isi di
# Vercel: Project Settings -> Environment Variables
# ============================================================

# Nama aplikasi (tampil di navbar & judul halaman)
VITE_APP_NAME="Nexa Router"

# Akun login aplikasi (ditentukan di env, bukan database)
VITE_AUTH_USER=admin
VITE_AUTH_PASS=ganti-password-ini

# API key FreeModel kamu (format: fm_...)
VITE_API_KEY=fm_your_key_here

# Base URL API (opsional, default FreeModel)
VITE_API_BASE=https://freemodel.in/v1
